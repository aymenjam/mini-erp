# Copy this file to .env and change the values. .env is never committed.
# All values below are fake and for local development only.

# PostgreSQL superuser (used only by the init script)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# One database user per service (same name as the database)
CUSTOMERS_DB_PASSWORD=change-me-customers
INVENTORY_DB_PASSWORD=change-me-inventory
SALES_DB_PASSWORD=change-me-sales
PURCHASING_DB_PASSWORD=change-me-purchasing
INVOICING_DB_PASSWORD=change-me-invoicing
ACCOUNTING_DB_PASSWORD=change-me-accounting
KEYCLOAK_DB_PASSWORD=change-me-keycloak

# Keycloak admin (master realm)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin

# Password of all dev users in the mini-erp realm (admin, sales, warehouse, ...)
DEV_USER_PASSWORD=change-me-dev-user

# --- Settings of a service (Spring). Not needed in dev mode: the profile "dev" uses the values above. ---
# Container mode and CI set these. Without the profile "dev" there are no defaults for the first four.
# DB_URL=jdbc:postgresql://localhost:5432/customers
# DB_USERNAME=customers
# DB_PASSWORD=change-me-customers
# ISSUER_URI=http://localhost:8080/realms/mini-erp
# SERVER_PORT=8080

# --- Settings of the gateway (Spring). Not needed in dev mode: the profile "dev" has defaults for the first four. ---
# Container mode and CI set these. Without the profile "dev" there are no defaults for the first four: a missing value stops the start at once.
# ISSUER_URI=http://localhost:8080/realms/mini-erp
# JWK_SET_URI=http://localhost:8080/realms/mini-erp/protocol/openid-connect/certs
# CUSTOMERS_URI=http://localhost:8091
# CORS_ALLOWED_ORIGIN=http://localhost:4200
# Timeouts towards the services, in milliseconds. These two have defaults (the values below).
# Connect timeout: the service cannot be reached in time (answer 504). Response timeout: it answers too slowly (answer 504).
# GATEWAY_CONNECT_TIMEOUT_MS=2000
# GATEWAY_RESPONSE_TIMEOUT_MS=10000
