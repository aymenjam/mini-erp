# Lombok is allowed only for @Getter, @RequiredArgsConstructor, @Slf4j and @NoArgsConstructor(access = AccessLevel.PROTECTED),
# only in infrastructure (.claude/rules/lombok.md). Every other feature below is a compile error.
# @NoArgsConstructor is not listed here: this file cannot check its access level. LombokUsageTest checks it
# (only the protected form, only in infrastructure.out.persistence). LombokUsageTest also checks where Lombok is used.
# Why setters are banned on JPA entities: docs/jpa-entities.md.
config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true

# Hides equals, hashCode, toString and setters in one annotation. Unsafe on JPA entities.
lombok.data.flagUsage = error
# Makes the class final and adds equals, hashCode and toString. Use records in the domain.
lombok.value.flagUsage = error
# Anyone can change any field at any time, also id and version, and skip the business rules. Use named methods.
lombok.setter.flagUsage = error
# Prints all fields. It can trigger lazy loading of related data.
lombok.toString.flagUsage = error
# Equality on all fields breaks with JPA identity and proxies. The policy is decided with the first real entity.
lombok.equalsAndHashCode.flagUsage = error
# A new field can be forgotten silently, and the constructor rules are skipped.
lombok.builder.flagUsage = error
# Skips the explicit constructors: a new field silently changes the constructor.
lombok.allArgsConstructor.flagUsage = error
# Hides the real type. Plain "var" is enough.
lombok.val.flagUsage = error
# Hides checked exceptions from the compiler and from the reader.
lombok.sneakyThrows.flagUsage = error
# No stable contract. Each feature needs an ADR first.
lombok.experimental.flagUsage = error
